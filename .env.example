# ── LLM-Konfiguration ──────────────────────────────
# Endpunkt der OpenAI-kompatiblen API
# Für OpenCode Zen: https://opencode.ai/zen/v1
# Für OpenRouter:   https://openrouter.ai/api/v1
LLM_API_BASE_URL=https://opencode.ai/zen/v1

# API-Key (vom Provider bereitgestellt)
LLM_API_KEY=sk-your-key-here

# Modellname (exakt wie vom Provider benannt)
# OpenCode Zen: claude-opus-4-6, claude-sonnet-4, gemini-3-pro, gpt-5.2
# OpenRouter:   anthropic/claude-sonnet-4, openai/gpt-4o
LLM_MODEL=claude-sonnet-4

# Generierungsparameter
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096

# ── Whisper-Konfiguration ──────────────────────────
WHISPER_MODEL=base
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=fr

# ── Datenbank ──────────────────────────────────────
DATABASE_URL=sqlite:///data/coach.db

# ── Allgemein ──────────────────────────────────────
TTS_SPEED=0.85
LOG_LEVEL=info
