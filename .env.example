# ── LLM-Konfiguration ──────────────────────────────
# Endpunkt der OpenAI-kompatiblen Chat-Completions-API.
# OpenCode Console (pay-as-you-go): https://opencode.ai/inference/openai/v1
# OpenRouter:                       https://openrouter.ai/api/v1
LLM_API_BASE_URL=https://opencode.ai/inference/openai/v1

# API-Key (vom Provider bereitgestellt)
LLM_API_KEY=sk-your-key-here

# Nur der Trainingsplan. ID ohne Provider-Prefix.
# Sonnet-Äquivalent bei Grok: grok-4.7
# Weitere Console-IDs: claude-sonnet-5-5, claude-haiku-5-5, gemini-4-argon, gpt-6.2-sol
LLM_MODEL=grok-4.7

# Generierungsparameter
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096

# ── Lokales LLM (Ollama) ───────────────────────────
# Lektionen, Übungen, Aussprache-Feedback, Fehleranalyse.
# Ollama muss auf dem Host laufen: ollama pull gemma4
# Ersetzt die alten Beispiele llama3, mistral, gemma2.
OLLAMA_API_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_MODEL=gemma4

# ── Whisper-Konfiguration ──────────────────────────
WHISPER_MODEL=base
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=fr

# ── Datenbank ──────────────────────────────────────
DATABASE_URL=sqlite:///data/coach.db

# ── Allgemein ──────────────────────────────────────
TTS_SPEED=0.85
LOG_LEVEL=info
